# Copy this file to .env (it is in .gitignore) and fill in your values.
# Every variable the code reads is listed here. Values below are placeholders only.
# The app reads .env once at start: restart it after changing this file.

# --- PostgreSQL (docker compose and the loader scripts read all five) -----------------
# Optional. Defaults if left out: app / app / smard / 5432 / localhost.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=smard
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Read-only database role (grader and app) ---------------------------------------
# Required for the grader, the safe runner and the app. The role is created by sql/create_grader_role.sql.
GRADER_DB_USER=grader_ro
# Required. The password you choose for that role (pass the same one to create_grader_role.sql).
GRADER_DB_PASSWORD=choose-a-password

# --- OpenAI -----------------------------------------------------------------------
# Required for exam runs and for the app (the model that writes the SQL and the summary).
OPENAI_API_KEY=sk-your-key-here

# --- Langfuse tracing in the app (D45) ----------------------------------------------
# Optional. Tracing is on only if all three of the next values are set; otherwise the app shows "tracing off".
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
# Use https://cloud.langfuse.com for the EU region, https://us.cloud.langfuse.com for the US region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Deprecated name for LANGFUSE_BASE_URL, still accepted if LANGFUSE_BASE_URL is not set. Leave it out.
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Exam runs ----------------------------------------------------------------------
# Optional. A tag added to the name of a results file by the grader/run_*.py scripts.
# RUN_TAG=
