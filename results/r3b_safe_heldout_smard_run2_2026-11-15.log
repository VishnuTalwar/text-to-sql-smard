    AND zeitpunkt >= '2024-12-01' AND zeitpunkt < '2026-01-01'
  GROUP BY 1
),
d AS (
  SELECT monat, durchschnittspreis,
         durchschnittspreis - LAG(durchschnittspreis) OVER (ORDER BY monat) AS veraenderung
