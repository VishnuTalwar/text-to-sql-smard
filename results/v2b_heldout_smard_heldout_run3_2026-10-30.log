  SELECT start_time, COUNT(*) AS max_stretch
  FROM (
    SELECT zeitpunkt AS start_time, 
           zeitpunkt - INTERVAL '15 minutes' * ROW_NUMBER() OVER (ORDER BY zeitpunkt) AS grp
    FROM preise
    WHERE preiszone = 'Deutschland/Luxemburg' AND preis_eur_mwh < 0 AND EXTRACT(YEAR FROM zeitpunkt) = 2025
  ) sub
  GROUP BY grp, start_time
  ORDER BY max_stretch DESC
