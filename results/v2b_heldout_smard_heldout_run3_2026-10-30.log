Retrieved: ['preise']
Question:  What was the longest uninterrupted stretch of negative German power prices in 2025? When did it start and how many quarter-hours did it last?
Gold SQL:  WITH p AS (
  SELECT zeitpunkt, preis_eur_mwh,
         ROW_NUMBER() OVER (ORDER BY zeitpunkt, id) AS rn
  FROM preise
  WHERE preiszone = 'Deutschland/Luxemburg'
    AND zeitpunkt >= '2025-01-01' AND zeitpunkt < '2026-01-01'
),
neg AS (
  SELECT zeitpunkt, rn - ROW_NUMBER() OVER (ORDER BY rn) AS grp
  FROM p
  WHERE preis_eur_mwh < 0
)
SELECT MIN(zeitpunkt) AS beginn, COUNT(*) AS viertelstunden
FROM neg
GROUP BY grp
ORDER BY viertelstunden DESC, beginn
LIMIT 1;
