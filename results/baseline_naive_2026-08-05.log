--- t3_06 (tier 3) ---
Question:  How did solar in 2025 compare to 2024, in absolute terms and percent?
Gold SQL:  WITH j AS (
  SELECT EXTRACT(YEAR FROM zeitpunkt)::int AS jahr, SUM(mwh) AS mwh
  FROM erzeugung
  WHERE energietraeger = 'Photovoltaik'
    AND zeitpunkt >= '2024-01-01' AND zeitpunkt < '2026-01-01'
  GROUP BY 1
)
SELECT
  MAX(mwh) FILTER (WHERE jahr = 2024) AS mwh_2024,
  MAX(mwh) FILTER (WHERE jahr = 2025) AS mwh_2025,
  MAX(mwh) FILTER (WHERE jahr = 2025) - MAX(mwh) FILTER (WHERE jahr = 2024) AS differenz_mwh,
  ROUND(100 * (MAX(mwh) FILTER (WHERE jahr = 2025) - MAX(mwh) FILTER (WHERE jahr = 2024))
        / MAX(mwh) FILTER (WHERE jahr = 2024), 2) AS veraenderung_prozent
FROM j;
Agent SQL: SELECT
    '2024' AS year,
    SUM(CASE WHEN DATE_PART('year', zeitpunkt) = 2024 AND energietraeger = 'Photovoltaik' THEN mwh ELSE 0 END) AS mwh_2024,
    '2025' AS year,
    SUM(CASE WHEN DATE_PART('year', zeitpunkt) = 2025 AND energietraeger = 'Photovoltaik' THEN mwh ELSE 0 END) AS mwh_2025,
    SUM(CASE WHEN DATE_PART('year', zeitpunkt) = 2025 AND energietraeger = 'Photovoltaik' THEN mwh ELSE 0 END) -
    SUM(CASE WHEN DATE_PART('year', zeitpunkt) = 2024 AND energietraeger = 'Photovoltaik' THEN mwh ELSE 0 END) AS difference_mwh,
    CASE WHEN SUM(CASE WHEN DATE_PART('year', zeitpunkt) = 2024 AND energietraeger = 'Photovoltaik' THEN mwh ELSE 0 END) = 0 THEN NULL
    ELSE
    ((SUM(CASE WHEN DATE_PART('year', zeitpunkt) = 2025 AND energietraeger = 'Photovoltaik' THEN mwh ELSE 0 END) -
    SUM(CASE WHEN DATE_PART('year', zeitpunkt) = 2024 AND energietraeger = 'Photovoltaik' THEN mwh ELSE 0 END)) /
    SUM(CASE WHEN DATE_PART('year', zeitpunkt) = 2024 AND energietraeger = 'Photovoltaik' THEN mwh ELSE 0 END)::numeric * 100) END AS percent_change
FROM erzeugung
WHERE DATE_PART('year', zeitpunkt) IN (2024, 2025) AND energietraeger = 'Photovoltaik';
