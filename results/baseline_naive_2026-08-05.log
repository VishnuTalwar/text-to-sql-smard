--- t4_02 (tier 4) ---
Question:  What was the longest unbroken stretch where solar output was zero?
Gold SQL:  WITH pv AS (
  SELECT zeitpunkt, mwh,
         ROW_NUMBER() OVER (ORDER BY zeitpunkt) AS rn
  FROM erzeugung WHERE energietraeger = 'Photovoltaik'
), null_lauf AS (
  SELECT zeitpunkt, rn, rn - ROW_NUMBER() OVER (ORDER BY zeitpunkt) AS gruppe
  FROM pv WHERE mwh = 0
)
SELECT MIN(zeitpunkt) AS beginn, MAX(zeitpunkt) AS ende,
       COUNT(*) AS viertelstunden, ROUND(COUNT(*) / 4.0, 2) AS stunden
FROM null_lauf
GROUP BY gruppe
ORDER BY viertelstunden DESC LIMIT 1;
Agent SQL: SELECT MAX(consecutive_hours) AS longest_zero_solar_output
FROM (
  SELECT
    zeitpunkt,
    COUNT(*) OVER (PARTITION BY grp) AS consecutive_hours
  FROM (
    SELECT
      zeitpunkt,
      SUM(mwh) AS total_mwh,
      SUM(mwh) = 0 AND LAG(SUM(mwh), 1, 1) OVER (ORDER BY zeitpunkt) = 0 AS grp
    FROM erzeugung
    WHERE energietraeger = 'Photovoltaik'
    GROUP BY zeitpunkt
  ) subquery
  WHERE total_mwh = 0
) final_query;
