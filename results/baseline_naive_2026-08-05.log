--- t4_04 (tier 4) ---
Question:  What was the longest run of consecutive quarter-hours with a negative German price?
Gold SQL:  WITH p AS (
  SELECT zeitpunkt, preis_eur_mwh,
         ROW_NUMBER() OVER (ORDER BY zeitpunkt) AS rn
  FROM preise WHERE preiszone = 'Deutschland/Luxemburg'
), neg AS (
  SELECT zeitpunkt, rn - ROW_NUMBER() OVER (ORDER BY zeitpunkt) AS gruppe
  FROM p WHERE preis_eur_mwh < 0
)
SELECT MIN(zeitpunkt) AS beginn, MAX(zeitpunkt) AS ende,
       COUNT(*) AS viertelstunden, ROUND(COUNT(*) / 4.0, 2) AS stunden
FROM neg
GROUP BY gruppe
ORDER BY viertelstunden DESC LIMIT 1;
Agent SQL: SELECT MAX(consecutive_quarters) AS longest_run
FROM (
  SELECT zeitpunkt,
         SUM(is_negative * is_new_group) OVER (ORDER BY zeitpunkt) AS group_id
  FROM (
    SELECT zeitpunkt,
           CASE WHEN preis_eur_mwh < 0 THEN 1 ELSE 0 END AS is_negative,
           CASE WHEN preis_eur_mwh < 0 AND LAG(preis_eur_mwh) OVER (ORDER BY zeitpunkt) >= 0 THEN 1 ELSE 0 END AS is_new_group
    FROM preise
    WHERE preiszone = 'Deutschland/Luxemburg'
  ) subquery
) grouped_prices
WHERE is_negative = 1
GROUP BY group_id
ORDER BY longest_run DESC
LIMIT 1;
