  SELECT date_trunc('hour', zeitpunkt) AS stunde, SUM(mwh) AS erzeugt
  FROM erzeugung GROUP BY 1
), v AS (
  SELECT date_trunc('hour', zeitpunkt) AS stunde, SUM(mwh) AS verbraucht
  FROM verbrauch WHERE metrik = 'grid load' GROUP BY 1
)
SELECT e.stunde, e.erzeugt, v.verbraucht, e.erzeugt - v.verbraucht AS ueberschuss_mwh
FROM e JOIN v USING (stunde)
WHERE e.erzeugt > v.verbraucht
ORDER BY e.stunde;
